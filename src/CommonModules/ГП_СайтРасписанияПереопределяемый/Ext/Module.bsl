// Общий модуль ГП_СайтРасписанияПереопределяемый
// Флаги: Сервер = Истина; Клиент, ВызовСервера, Глобальный, Привилегированный = Ложь.
//
// Точка подключения данных конфигурации. В моке — демонстрационный набор;
// пример заполнения по данным ИБ — ЗаполнитьПоДаннымКонфигурации().

#Область ПрограммныйИнтерфейс

// Заполняет снимок группами и занятиями за период.
//
// Параметры:
//  Снимок - см. ГП_СайтРасписания.НовыйСнимок
//  НачалоПериода - Дата
//  КонецПериода - Дата
//
Процедура ПриФормированииСнимка(Снимок, Знач НачалоПериода, Знач КонецПериода, Знач Организация = Неопределено) Экспорт
    
	//ЗаполнитьДемоДанными(Снимок, НачалоПериода, КонецПериода);
    
    Если Организация = Неопределено Тогда
        Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
    КонецЕсли;
    
    ЗаполнитьПоДаннымКонфигурации(Снимок, НачалоПериода, КонецПериода, Организация);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пример для рабочей конфигурации. Имена справочников и регистров условные — заменить на объекты
// конкретной конфигурации. Ид групп берутся из регистра ГП_ИдентификаторыДляСайтаРасписания; если у группы
// ид нет, он попадает в снимок пустым и ГП_СайтРасписания.ПроверитьСнимок() остановит выгрузку.
// Ид отделений и факультетов в ссылки сайта не попадают, для них достаточно кода справочника.
//
Процедура ЗаполнитьПоДаннымКонфигурации(Снимок, Знач НачалоПериода, Знач КонецПериода, Знач Организация)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(КонецПериода));
    Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ
        |	РасписаниеЗанятийУпрощенный.Период КАК Период,
        |	РасписаниеЗанятийУпрощенный.Регистратор КАК Регистратор,
        |	РасписаниеЗанятийУпрощенный.НомерСтроки КАК НомерСтроки,
        |	РасписаниеЗанятийУпрощенный.Активность КАК Активность,
        |	РасписаниеЗанятийУпрощенный.Организация КАК Организация,
        |	РасписаниеЗанятийУпрощенный.Факультет КАК Факультет,
        |	РасписаниеЗанятийУпрощенный.ФормаОбучения КАК ФормаОбучения,
        |	РасписаниеЗанятийУпрощенный.Курс КАК Курс,
        |	РасписаниеЗанятийУпрощенный.Группа КАК Группа,
        |	РасписаниеЗанятийУпрощенный.ДатаЗанятий КАК ДатаЗанятий,
        |	РасписаниеЗанятийУпрощенный.НомерПары КАК НомерПары,
        |	РасписаниеЗанятийУпрощенный.Корректировка КАК Корректировка,
        |	РасписаниеЗанятийУпрощенный.ВремяНачала КАК ВремяНачала,
        |	РасписаниеЗанятийУпрощенный.ВремяОкончания КАК ВремяОкончания,
        |	РасписаниеЗанятийУпрощенный.Аудитория КАК Аудитория,
        |	РасписаниеЗанятийУпрощенный.Корпус КАК Корпус,
        |	РасписаниеЗанятийУпрощенный.Предмет КАК Предмет,
        |	РасписаниеЗанятийУпрощенный.ТипЗанятия КАК ТипЗанятия,
        |	РасписаниеЗанятийУпрощенный.Преподаватель КАК Преподаватель
        |ПОМЕСТИТЬ ВТ_РасписаниеЗанятий_ВсеДанные
        |ИЗ
        |	РегистрСведений.ГП_РасписаниеЗанятийУпрощенный.СрезПоследних(, 
        |		Организация = &Организация И ДатаЗанятий <= &ДатаОкончания И ДатаЗанятий >= &ДатаНачала И Активность = ИСТИНА) КАК РасписаниеЗанятийУпрощенный
        |ГДЕ
        |	ИСТИНА
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗЛИЧНЫЕ
        |	РасписаниеЗанятий.Группа КАК Ссылка
        |ПОМЕСТИТЬ ВТ_ГруппыРасписаний
        |ИЗ
        |	ВТ_РасписаниеЗанятий_ВсеДанные КАК РасписаниеЗанятий
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |	Группы.Ссылка КАК Ссылка,
        |	ЕСТЬNULL(Ид.Идентификатор, """""""") КАК ИдГруппы
        |ПОМЕСТИТЬ ВТ_Группы
        |ИЗ
        |	Справочник.УчебныеГруппы КАК Группы
        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГП_ИдентификаторыДляСайтаРасписания КАК Ид
        |		ПО (Ид.Объект = Группы.Ссылка)
        |ГДЕ
        |	ИСТИНА
        |	И Группы.Ссылка В
        |			(ВЫБРАТЬ
        |				Т.Ссылка
        |			ИЗ
        |				ВТ_ГруппыРасписаний КАК Т)
        |
        |ИНДЕКСИРОВАТЬ ПО
        |	Ссылка
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗЛИЧНЫЕ
        |	РасписаниеЗанятий.ФормаОбучения.Код КАК ИдОтделения,
        |	РасписаниеЗанятий.ФормаОбучения.Наименование КАК Отделение,
        |	РасписаниеЗанятий.Факультет.Код КАК ИдФакультета,
        |	РасписаниеЗанятий.Факультет.Наименование КАК Факультет,
        |	РасписаниеЗанятий.Курс.ПорядковыйНомер КАК Курс,
        |	Группы.ИдГруппы КАК ИдГруппы,
        |	РасписаниеЗанятий.Группа.Наименование КАК Группа
        |ИЗ
        |	ВТ_РасписаниеЗанятий_ВсеДанные КАК РасписаниеЗанятий
        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Группы КАК Группы
        |		ПО РасписаниеЗанятий.Группа = Группы.Ссылка
        |
        |УПОРЯДОЧИТЬ ПО
        |	Факультет,
        |	Курс,
        |	ИдГруппы
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |	Группы.ИдГруппы КАК ИдГруппы,
        |	Расписание.ДатаЗанятий КАК Дата,
        |	Расписание.НомерПары КАК НомерПары,
        |	Расписание.ВремяНачала КАК Начало,
        |	Расписание.ВремяОкончания КАК Окончание,
        |	Расписание.Предмет.Наименование КАК Дисциплина,
        |	Расписание.ТипЗанятия КАК ВидЗанятия,
        |	Расписание.Аудитория.Наименование КАК Аудитория,
        |	Расписание.Корпус.Наименование КАК Корпус,
        |	Расписание.Преподаватель.ФизическоеЛицо КАК ПреподавательФизическоеЛицо,
        |	Расписание.Преподаватель.ФизическоеЛицо.Фамилия КАК ПреподавательФамилия,
        |	Расписание.Преподаватель.ФизическоеЛицо.Имя КАК ПреподавательИмя,
        |	Расписание.Преподаватель.ФизическоеЛицо.Отчество КАК ПреподавательОтчество,
        |	Расписание.Преподаватель.Наименование КАК Преподаватель
        |ИЗ
        |	ВТ_РасписаниеЗанятий_ВсеДанные КАК Расписание
        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Группы КАК Группы
        |		ПО Расписание.Группа = Группы.Ссылка
        |
        |УПОРЯДОЧИТЬ ПО
        |	ИдГруппы,
        |	Дата,
        |	Начало";
    
	Результаты = Запрос.ВыполнитьПакет();
	ВыборкаГрупп = Результаты[Результаты.Количество() - 2].Выбрать();
	ВыборкаЗанятий = Результаты[Результаты.Количество() - 1].Выбрать();

	Отделения = Новый Соответствие;
	Факультеты = Новый Соответствие;
	Курсы = Новый Соответствие;

	Выборка = ВыборкаГрупп;
	Пока Выборка.Следующий() Цикл

		Отделение = Отделения.Получить(Выборка.ИдОтделения);
		Если Отделение = Неопределено Тогда
			Отделение = ГП_СайтРасписания.ДобавитьОтделение(Снимок, Выборка.ИдОтделения, Выборка.Отделение);
			Отделения.Вставить(Выборка.ИдОтделения, Отделение);
		КонецЕсли;

		КлючФакультета = Выборка.ИдОтделения + "/" + Выборка.ИдФакультета;
		Факультет = Факультеты.Получить(КлючФакультета);
		Если Факультет = Неопределено Тогда
			Факультет = ГП_СайтРасписания.ДобавитьФакультет(Отделение, Выборка.ИдФакультета, Выборка.Факультет);
			Факультеты.Вставить(КлючФакультета, Факультет);
		КонецЕсли;

		КлючКурса = КлючФакультета + "/" + Формат(Выборка.Курс, "ЧГ=0");
		Курс = Курсы.Получить(КлючКурса);
		Если Курс = Неопределено Тогда
			Курс = ГП_СайтРасписания.ДобавитьКурс(Факультет, Выборка.Курс);
			Курсы.Вставить(КлючКурса, Курс);
		КонецЕсли;

		ГП_СайтРасписания.ДобавитьГруппу(Снимок, Курс, Выборка.ИдГруппы, Выборка.Группа);

	КонецЦикла;

	Выборка = ВыборкаЗанятий;
    Пока Выборка.Следующий() Цикл
        ТекПредставлениеКорпуса = "";
        Если ЗначениеЗаполнено(Выборка.Корпус) Тогда
            ТекПредставлениеКорпуса = СокрЛП(Строка(Выборка.Корпус));
        	ТекПредставлениеКорпуса = СтрЗаменитьПоРегулярномуВыражению(ТекПредставлениеКорпуса, "(корпус|к.)", "", Истина, Ложь);
            ТекПредставлениеКорпуса = СокрЛП(ТекПредставлениеКорпуса);
        КонецЕсли;
        
        ТекПредставлениеАудитории = СокрЛП(Строка(Выборка.Аудитория));
        ТекПредставлениеАудитории = СтрЗаменитьПоРегулярномуВыражению(ТекПредставлениеАудитории, "аудитория", "", Истина, Ложь);
        ТекПредставлениеАудитории = СокрЛП(Выборка.Аудитория);
        ТекПредставлениеАудитории = "Ауд." + ТекПредставлениеАудитории + ?(ЗначениеЗаполнено(ТекПредставлениеКорпуса), СтрШаблон(", корп. %1", ТекПредставлениеКорпуса), "");
        
        ПреподавательФИО = Новый Структура("Фамилия, Имя, Отчество", Выборка.ПреподавательФамилия, Выборка.ПреподавательИмя, Выборка.ПреподавательОтчество);
        ТекПредставлениеСотрудник = ФизическиеЛицаСервер.ПолучитьСокращенноеФИО(ПреподавательФИО); 
        
		ГП_СайтРасписания.ДобавитьЗанятие(Снимок, Выборка.ИдГруппы, Выборка.Дата,
			Выборка.Начало, Выборка.Окончание, Выборка.Дисциплина, НРег(СокрЛП(Выборка.ВидЗанятия)),
			ТекПредставлениеАудитории, ТекПредставлениеСотрудник);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьДемоДанными(Снимок, НачалоПериода, КонецПериода)

	Очное = ГП_СайтРасписания.ДобавитьОтделение(Снимок, "full-time", "Очное отделение");
	МТХ = ГП_СайтРасписания.ДобавитьФакультет(Очное, "fmtkh", "Факультет музыки, театра и хореографии");
	Курс2 = ГП_СайтРасписания.ДобавитьКурс(МТХ, 2);
	ГП_СайтРасписания.ДобавитьГруппу(Снимок, Курс2, "fmtkh-2-01", "МТХ-201");
	ГП_СайтРасписания.ДобавитьГруппу(Снимок, Курс2, "fmtkh-2-02", "МТХ-202");

	Заочное = ГП_СайтРасписания.ДобавитьОтделение(Снимок, "part-time", "Заочное отделение");
	СКТ = ГП_СайтРасписания.ДобавитьФакультет(Заочное, "fskt", "Факультет социально-культурных технологий");
	Курс4 = ГП_СайтРасписания.ДобавитьКурс(СКТ, 4);
	ГП_СайтРасписания.ДобавитьГруппу(Снимок, Курс4, "fskt-z-4-01", "СКТз-401");

	Пары = ДемоПары();
	Занятия = ДемоЗанятия();
	ГруппыОчные = СтрРазделить("fmtkh-2-01,fmtkh-2-02", ",");

	День = НачалоДня(НачалоПериода);
	Пока День <= КонецПериода Цикл

		НомерДня = ДеньНедели(День);
		Если НомерДня <= 5 Тогда
			Для НомерГруппы = 0 По ГруппыОчные.ВГраница() Цикл
				КоличествоПар = 2 + (НомерДня + НомерГруппы) % 2;
				Для НомерПары = 0 По КоличествоПар - 1 Цикл
					Пара = Пары[НомерПары];
					Занятие = Занятия[(НомерДня * 3 + НомерПары + НомерГруппы * 2) % Занятия.Количество()];
					ГП_СайтРасписания.ДобавитьЗанятие(Снимок, ГруппыОчные[НомерГруппы], День,
						Пара.Начало, Пара.Окончание,
						Занятие.Дисциплина, Занятие.Вид, Занятие.Аудитория, Занятие.Преподаватель);
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;

		День = День + 86400;

	КонецЦикла;

	// Заочники: консультация и зачёт в последнюю субботу периода.
	Суббота = НачалоНедели(КонецПериода) + 5 * 86400;
	ГП_СайтРасписания.ДобавитьЗанятие(Снимок, "fskt-z-4-01", Суббота, "09:00", "10:30",
		"Менеджмент социально-культурной деятельности", "консультация", "Ауд. 204", "Морозова Т.А.");
	ГП_СайтРасписания.ДобавитьЗанятие(Снимок, "fskt-z-4-01", Суббота, "10:45", "12:15",
		"Менеджмент социально-культурной деятельности", "зачёт", "Ауд. 204", "Морозова Т.А.");

КонецПроцедуры

Функция ДемоПары()

	Пары = Новый Массив;
	Пары.Добавить(Новый Структура("Начало, Окончание", "09:00", "10:30"));
	Пары.Добавить(Новый Структура("Начало, Окончание", "10:45", "12:15"));
	Пары.Добавить(Новый Структура("Начало, Окончание", "13:00", "14:30"));
	Возврат Пары;

КонецФункции

Функция ДемоЗанятия()

	Занятия = Новый Массив;
	ДобавитьДемоЗанятие(Занятия, "История музыки", "лекция", "Ауд. 301", "Соколова Н.В.");
	ДобавитьДемоЗанятие(Занятия, "Ансамбль", "практика", "Ауд. 118", "Андреев Ю.Л.");
	ДобавитьДемоЗанятие(Занятия, "Сольфеджио", "семинар", "Ауд. 214", "Лебедева А.С.");
	ДобавитьДемоЗанятие(Занятия, "Звукорежиссура", "лабораторная", "Студия звукозаписи", "Волков Д.А.");
	ДобавитьДемоЗанятие(Занятия, "Хоровой класс", "практика", "Концертный зал", "Смирнова В.А.");
	ДобавитьДемоЗанятие(Занятия, "Философия", "лекция", "Ауд. 105", "Кузнецов П.Р.");
	ДобавитьДемоЗанятие(Занятия, "Иностранный язык", "практика", "Ауд. 220", "Новикова Е.М.");
	Возврат Занятия;

КонецФункции

Процедура ДобавитьДемоЗанятие(Занятия, Дисциплина, Вид, Аудитория, Преподаватель)

	Занятия.Добавить(Новый Структура("Дисциплина, Вид, Аудитория, Преподаватель",
		Дисциплина, Вид, Аудитория, Преподаватель));

КонецПроцедуры

#КонецОбласти
