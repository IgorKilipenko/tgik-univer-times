// Общий модуль ГП_СайтРасписанияПереопределяемый
// Флаги: Сервер = Истина; Клиент, ВызовСервера, Глобальный, Привилегированный = Ложь.
//
// Точка подключения данных конфигурации. В моке — демонстрационный набор;
// пример заполнения по данным ИБ — ЗаполнитьПоДаннымКонфигурации().

#Область ПрограммныйИнтерфейс

// Заполняет снимок группами и занятиями за период.
//
// Параметры:
//  Снимок - см. ГП_СайтРасписания.НовыйСнимок
//  НачалоПериода - Дата
//  КонецПериода - Дата
//
Процедура ПриФормированииСнимка(Снимок, НачалоПериода, КонецПериода) Экспорт

	ЗаполнитьДемоДанными(Снимок, НачалоПериода, КонецПериода);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пример для рабочей конфигурации. Имена справочников и регистров условные — заменить на объекты
// конкретной конфигурации. Ид групп берутся из регистра ГП_ИдентификаторыДляСайтаРасписания; если у группы
// ид нет, он попадает в снимок пустым и ГП_СайтРасписания.ПроверитьСнимок() остановит выгрузку.
// Ид отделений и факультетов в ссылки сайта не попадают, для них достаточно кода справочника.
//
Процедура ЗаполнитьПоДаннымКонфигурации(Снимок, НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Группы.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(Ид.Идентификатор, """") КАК ИдГруппы
	|ПОМЕСТИТЬ ВТГруппы
	|ИЗ
	|	Справочник.УчебныеГруппы КАК Группы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГП_ИдентификаторыДляСайтаРасписания КАК Ид
	|		ПО (Ид.Объект = Группы.Ссылка)
	|ГДЕ
	|	НЕ Группы.ПометкаУдаления
	|	И Группы.ПубликоватьНаСайте
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТГруппы.Ссылка.Отделение.Код КАК ИдОтделения,
	|	ВТГруппы.Ссылка.Отделение.Наименование КАК Отделение,
	|	ВТГруппы.Ссылка.Факультет.Код КАК ИдФакультета,
	|	ВТГруппы.Ссылка.Факультет.Наименование КАК Факультет,
	|	ВТГруппы.Ссылка.Курс КАК Курс,
	|	ВТГруппы.ИдГруппы КАК ИдГруппы,
	|	ВТГруппы.Ссылка.Наименование КАК Группа
	|ИЗ
	|	ВТГруппы КАК ВТГруппы
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТГруппы.Ссылка.Отделение.Порядок,
	|	Факультет,
	|	Курс,
	|	Группа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТГруппы.ИдГруппы КАК ИдГруппы,
	|	Расписание.Дата КАК Дата,
	|	Расписание.ВремяНачала КАК Начало,
	|	Расписание.ВремяОкончания КАК Окончание,
	|	Расписание.Дисциплина.Наименование КАК Дисциплина,
	|	Расписание.ВидЗанятия.Наименование КАК ВидЗанятия,
	|	Расписание.Аудитория.Наименование КАК Аудитория,
	|	Расписание.Преподаватель.Наименование КАК Преподаватель
	|ИЗ
	|	РегистрСведений.РасписаниеЗанятий КАК Расписание
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТГруппы КАК ВТГруппы
	|		ПО (ВТГруппы.Ссылка = Расписание.Группа)
	|ГДЕ
	|	Расписание.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ Расписание.Отменено
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИдГруппы,
	|	Дата,
	|	Начало";

	Результаты = Запрос.ВыполнитьПакет();
	ВыборкаГрупп = Результаты[1].Выбрать();
	ВыборкаЗанятий = Результаты[2].Выбрать();

	Отделения = Новый Соответствие;
	Факультеты = Новый Соответствие;
	Курсы = Новый Соответствие;

	Выборка = ВыборкаГрупп;
	Пока Выборка.Следующий() Цикл

		Отделение = Отделения.Получить(Выборка.ИдОтделения);
		Если Отделение = Неопределено Тогда
			Отделение = ГП_СайтРасписания.ДобавитьОтделение(Снимок, Выборка.ИдОтделения, Выборка.Отделение);
			Отделения.Вставить(Выборка.ИдОтделения, Отделение);
		КонецЕсли;

		КлючФакультета = Выборка.ИдОтделения + "/" + Выборка.ИдФакультета;
		Факультет = Факультеты.Получить(КлючФакультета);
		Если Факультет = Неопределено Тогда
			Факультет = ГП_СайтРасписания.ДобавитьФакультет(Отделение, Выборка.ИдФакультета, Выборка.Факультет);
			Факультеты.Вставить(КлючФакультета, Факультет);
		КонецЕсли;

		КлючКурса = КлючФакультета + "/" + Формат(Выборка.Курс, "ЧГ=0");
		Курс = Курсы.Получить(КлючКурса);
		Если Курс = Неопределено Тогда
			Курс = ГП_СайтРасписания.ДобавитьКурс(Факультет, Выборка.Курс);
			Курсы.Вставить(КлючКурса, Курс);
		КонецЕсли;

		ГП_СайтРасписания.ДобавитьГруппу(Снимок, Курс, Выборка.ИдГруппы, Выборка.Группа);

	КонецЦикла;

	Выборка = ВыборкаЗанятий;
	Пока Выборка.Следующий() Цикл
		ГП_СайтРасписания.ДобавитьЗанятие(Снимок, Выборка.ИдГруппы, Выборка.Дата,
			Выборка.Начало, Выборка.Окончание, Выборка.Дисциплина, Выборка.ВидЗанятия,
			Выборка.Аудитория, Выборка.Преподаватель);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьДемоДанными(Снимок, НачалоПериода, КонецПериода)

	Очное = ГП_СайтРасписания.ДобавитьОтделение(Снимок, "full-time", "Очное отделение");
	МТХ = ГП_СайтРасписания.ДобавитьФакультет(Очное, "fmtkh", "Факультет музыки, театра и хореографии");
	Курс2 = ГП_СайтРасписания.ДобавитьКурс(МТХ, 2);
	ГП_СайтРасписания.ДобавитьГруппу(Снимок, Курс2, "fmtkh-2-01", "МТХ-201");
	ГП_СайтРасписания.ДобавитьГруппу(Снимок, Курс2, "fmtkh-2-02", "МТХ-202");

	Заочное = ГП_СайтРасписания.ДобавитьОтделение(Снимок, "part-time", "Заочное отделение");
	СКТ = ГП_СайтРасписания.ДобавитьФакультет(Заочное, "fskt", "Факультет социально-культурных технологий");
	Курс4 = ГП_СайтРасписания.ДобавитьКурс(СКТ, 4);
	ГП_СайтРасписания.ДобавитьГруппу(Снимок, Курс4, "fskt-z-4-01", "СКТз-401");

	Пары = ДемоПары();
	Занятия = ДемоЗанятия();
	ГруппыОчные = СтрРазделить("fmtkh-2-01,fmtkh-2-02", ",");

	День = НачалоДня(НачалоПериода);
	Пока День <= КонецПериода Цикл

		НомерДня = ДеньНедели(День);
		Если НомерДня <= 5 Тогда
			Для НомерГруппы = 0 По ГруппыОчные.ВГраница() Цикл
				КоличествоПар = 2 + (НомерДня + НомерГруппы) % 2;
				Для НомерПары = 0 По КоличествоПар - 1 Цикл
					Пара = Пары[НомерПары];
					Занятие = Занятия[(НомерДня * 3 + НомерПары + НомерГруппы * 2) % Занятия.Количество()];
					ГП_СайтРасписания.ДобавитьЗанятие(Снимок, ГруппыОчные[НомерГруппы], День,
						Пара.Начало, Пара.Окончание,
						Занятие.Дисциплина, Занятие.Вид, Занятие.Аудитория, Занятие.Преподаватель);
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;

		День = День + 86400;

	КонецЦикла;

	// Заочники: консультация и зачёт в последнюю субботу периода.
	Суббота = НачалоНедели(КонецПериода) + 5 * 86400;
	ГП_СайтРасписания.ДобавитьЗанятие(Снимок, "fskt-z-4-01", Суббота, "09:00", "10:30",
		"Менеджмент социально-культурной деятельности", "консультация", "Ауд. 204", "Морозова Т.А.");
	ГП_СайтРасписания.ДобавитьЗанятие(Снимок, "fskt-z-4-01", Суббота, "10:45", "12:15",
		"Менеджмент социально-культурной деятельности", "зачёт", "Ауд. 204", "Морозова Т.А.");

КонецПроцедуры

Функция ДемоПары()

	Пары = Новый Массив;
	Пары.Добавить(Новый Структура("Начало, Окончание", "09:00", "10:30"));
	Пары.Добавить(Новый Структура("Начало, Окончание", "10:45", "12:15"));
	Пары.Добавить(Новый Структура("Начало, Окончание", "13:00", "14:30"));
	Возврат Пары;

КонецФункции

Функция ДемоЗанятия()

	Занятия = Новый Массив;
	ДобавитьДемоЗанятие(Занятия, "История музыки", "лекция", "Ауд. 301", "Соколова Н.В.");
	ДобавитьДемоЗанятие(Занятия, "Ансамбль", "практика", "Ауд. 118", "Андреев Ю.Л.");
	ДобавитьДемоЗанятие(Занятия, "Сольфеджио", "семинар", "Ауд. 214", "Лебедева А.С.");
	ДобавитьДемоЗанятие(Занятия, "Звукорежиссура", "лабораторная", "Студия звукозаписи", "Волков Д.А.");
	ДобавитьДемоЗанятие(Занятия, "Хоровой класс", "практика", "Концертный зал", "Смирнова В.А.");
	ДобавитьДемоЗанятие(Занятия, "Философия", "лекция", "Ауд. 105", "Кузнецов П.Р.");
	ДобавитьДемоЗанятие(Занятия, "Иностранный язык", "практика", "Ауд. 220", "Новикова Е.М.");
	Возврат Занятия;

КонецФункции

Процедура ДобавитьДемоЗанятие(Занятия, Дисциплина, Вид, Аудитория, Преподаватель)

	Занятия.Добавить(Новый Структура("Дисциплина, Вид, Аудитория, Преподаватель",
		Дисциплина, Вид, Аудитория, Преподаватель));

КонецПроцедуры

#КонецОбласти
