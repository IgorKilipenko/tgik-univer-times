// Общий модуль ГП_СайтРасписанияСлужебный
// Флаги: Сервер = Истина; Клиент, ВызовСервера, Глобальный, Привилегированный = Ложь.
//
// HTTP-обмен с сайтом, обработчики событий БСП и регламентного задания.

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбработчикиСобытийБСП

// Вызывается из РегламентныеЗаданияПереопределяемый.ПриОпределенииНастроекРегламентныхЗаданий.
// Задание включается и выключается вместе с функциональной опцией.
//
// Параметры:
//  Настройки - см. РегламентныеЗаданияПереопределяемый.ПриОпределенииНастроекРегламентныхЗаданий.Настройки
//
Процедура ПриОпределенииНастроекРегламентныхЗаданий(Настройки) Экспорт

	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.ГП_ВыгрузкаРасписанияНаСайт;
	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.ГП_ИспользоватьВыгрузкуРасписанияНаСайт;
	Настройка.РаботаетСВнешнимиРесурсами = Истина;

КонецПроцедуры

// Вызывается из ОбщегоНазначенияПереопределяемый.ПриЗаполненииРазрешенийНаДоступКВнешнимРесурсам.
//
// Параметры:
//  ЗапросыРазрешений - Массив - см. РаботаВБезопасномРежиме.ЗапросНаИспользованиеВнешнихРесурсов.
//
Процедура ПриЗаполненииРазрешенийНаДоступКВнешнимРесурсам(ЗапросыРазрешений) Экспорт

	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЗапросыРазрешений,
		ЗапросыРазрешенийНаИспользованиеВнешнихРесурсов(ГП_СайтРасписания.АдресСайта()));

КонецПроцедуры

// Запросы разрешений профиля безопасности для адреса сайта. Используется также формой
// настроек при смене адреса (РаботаВБезопасномРежимеКлиент.ПрименитьЗапросыНаИспользованиеВнешнихРесурсов).
//
// Параметры:
//  АдресСайта - Строка
//
// Возвращаемое значение:
//  Массив из УникальныйИдентификатор
//
Функция ЗапросыРазрешенийНаИспользованиеВнешнихРесурсов(АдресСайта) Экспорт

	Запросы = Новый Массив;
	Если Не ЗначениеЗаполнено(АдресСайта) Тогда
		Возврат Запросы;
	КонецЕсли;

	URI = ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресСайта);
	Разрешения = Новый Массив;
	Разрешения.Добавить(РаботаВБезопасномРежиме.РазрешениеНаИспользованиеИнтернетРесурса(
		ВРег(URI.Схема), URI.Хост, URI.Порт, НСтр("ru = 'Выгрузка расписания занятий на сайт'")));

	Запросы.Добавить(РаботаВБезопасномРежиме.ЗапросНаИспользованиеВнешнихРесурсов(Разрешения,
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Константа.ГП_АдресСайтаРасписания")));

	Возврат Запросы;

КонецФункции

#КонецОбласти

#Область РегламентноеЗадание

// Метод регламентного задания ГП_ВыгрузкаРасписанияНаСайт.
// Рекомендуемое расписание: каждые 15–30 минут в рабочее время.
//
Процедура ВыгрузкаРасписанияНаСайт() Экспорт

	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.ГП_ВыгрузкаРасписанияНаСайт);

	Результат = ГП_СайтРасписания.ВыгрузитьРасписание();
	Если Не Результат.Успех Тогда
		// Исключение помечает выполнение задания как неуспешное.
		ВызватьИсключение ПредставлениеОшибкиОбмена(Результат);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Обмен

// Выполняет запрос к API сайта и разбирает ответ формата { ok, data, error }.
//
// Параметры:
//  Метод - Строка - "GET", "POST".
//  Ресурс - Строка - путь относительно /api/, например "internal/import.php".
//  ПараметрыЗапроса - Соответствие, Неопределено - параметры строки запроса.
//  Тело - Структура, Соответствие, Неопределено - сериализуется в JSON.
//
// Возвращаемое значение:
//  см. ГП_СайтРасписания.НовыйРезультатОбмена
//
Функция ВыполнитьЗапрос(Метод, Ресурс, ПараметрыЗапроса = Неопределено, Тело = Неопределено) Экспорт

	Результат = ГП_СайтРасписания.НовыйРезультатОбмена();

	АдресСайта = ГП_СайтРасписания.АдресСайта();
	Если Не ЗначениеЗаполнено(АдресСайта) Тогда
		Результат.КодОшибки = "not_configured";
		Результат.ТекстОшибки = НСтр("ru = 'Не задан адрес сайта расписания.'");
		Возврат Результат;
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");
	Если СтрНачинаетсяС(Ресурс, "internal/") Тогда
		Токен = ТокенИмпорта();
		Если Не ЗначениеЗаполнено(Токен) Тогда
			Результат.КодОшибки = "not_configured";
			Результат.ТекстОшибки = НСтр("ru = 'Не задан токен импорта сайта расписания.'");
			Возврат Результат;
		КонецЕсли;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;

	URI = ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресСайта);
	Запрос = Новый HTTPЗапрос("/api/" + Ресурс + СтрокаПараметров(ПараметрыЗапроса), Заголовки);
	Если Тело <> Неопределено Тогда
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(КомпактныйJSON(Тело), КодировкаТекста.UTF8,
			ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Попытка
		Ответ = НовоеСоединение(URI).ВызватьHTTPМетод(Метод, Запрос);
	Исключение
		Результат.КодОшибки = "network_error";
		Результат.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	РазобратьОтвет(Ответ, Результат);
	Возврат Результат;

КонецФункции

// Параметры:
//  Результат - см. ГП_СайтРасписания.НовыйРезультатОбмена
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеОшибкиОбмена(Результат) Экспорт

	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Ошибка обмена с сайтом расписания: HTTP %1, %2: %3'"),
		Результат.КодСостояния, Результат.КодОшибки, Результат.ТекстОшибки);

КонецФункции

// Параметры:
//  Результат - см. ГП_СайтРасписания.НовыйРезультатОбмена
//
Процедура ЗаписатьРезультатВыгрузкиВЖурнал(Результат) Экспорт

	Если Результат.Успех Тогда
		Статистика = Результат.Данные.Получить("stats");
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Расписание выгружено на сайт: групп %1, снимок от %2'"),
				Статистика.Получить("groups"), Статистика.Получить("generatedAt")));
	Иначе
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ПредставлениеОшибкиОбмена(Результат));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ИдентификаторыДляСайта

// Обработчик подписки на событие ГП_НазначитьИдентификаторДляСайта (ПриЗаписи).
//
// Параметры:
//  Источник - СправочникОбъект - объект с типом из ОпределяемыйТип.ГП_ОбъектСайтаРасписания.
//  Отказ - Булево
//
Процедура НазначитьИдентификаторПриЗаписи(Источник, Отказ) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Существующие = ГП_СайтРасписания.ИдентификаторыДляСайта(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Источник.Ссылка));
	Если Существующие.Количество() = 0 Тогда
		НазначитьИдентификатор(Источник.Ссылка, Источник.Наименование);
	КонецЕсли;

КонецПроцедуры

// Назначает объекту свободный ид на основе наименования.
//
// Параметры:
//  Объект - ОпределяемыйТип.ГП_ОбъектСайтаРасписания
//  Наименование - Строка
//
Процедура НазначитьИдентификатор(Объект, Наименование) Экспорт

	Основа = ГП_СайтРасписания.ИдентификаторИзНаименования(Наименование);
	Если Не ЗначениеЗаполнено(Основа) Тогда
		Основа = ГП_СайтРасписания.ИдентификаторИзНаименования(Строка(Объект.УникальныйИдентификатор()));
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьРегистрИдентификаторов();
		ЗаписатьВРегистр(Объект, СвободныйИдентификатор(Основа, Объект));
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Записывает заданный вручную ид с проверкой формата и уникальности.
//
// Параметры:
//  Объект - ОпределяемыйТип.ГП_ОбъектСайтаРасписания
//  Идентификатор - Строка
//
Процедура ЗаписатьИдентификатор(Объект, Идентификатор) Экспорт

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьРегистрИдентификаторов();
		Ошибка = ОшибкаИдентификатора(Объект, Идентификатор);
		Если ЗначениеЗаполнено(Ошибка) Тогда
			ВызватьИсключение Ошибка;
		КонецЕсли;
		ЗаписатьВРегистр(Объект, Идентификатор);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Используется также модулем набора записей регистра при ручном редактировании.
//
// Параметры:
//  Объект - ОпределяемыйТип.ГП_ОбъектСайтаРасписания
//  Идентификатор - Строка
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка — ид можно записать.
//
Функция ОшибкаИдентификатора(Объект, Идентификатор) Экспорт

	Если Не ГП_СайтРасписания.ИдентификаторДопустим(Идентификатор) Тогда
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ид для сайта «%1» недопустим: только a-z, 0-9 и дефис, не длиннее %2 символов.'"),
			Идентификатор, ГП_СайтРасписания.МаксимальнаяДлинаИдентификатора());
	КонецЕсли;

	Занят = ОбъектСИдентификатором(Идентификатор, Объект);
	Если ЗначениеЗаполнено(Занят) Тогда
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ид для сайта «%1» уже занят: %2.'"), Идентификатор, Занят);
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#Область ПроверкаСнимка

// См. ГП_СайтРасписания.ПроверитьСнимок.
//
// Параметры:
//  Снимок - см. ГП_СайтРасписания.НовыйСнимок
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ОшибкиСнимка(Снимок) Экспорт

	Ошибки = Новый Массив;
	Группы = Новый Соответствие; // ид → наименование

	Для Каждого Отделение Из Снимок.tree Цикл
		ПроверитьУзелДерева(Отделение, НСтр("ru = 'Отделение'"), Ошибки);
		Для Каждого Факультет Из Отделение.faculties Цикл
			ПроверитьУзелДерева(Факультет, НСтр("ru = 'Факультет'"), Ошибки);
			Для Каждого Курс Из Факультет.courses Цикл
				Для Каждого Группа Из Курс.groups Цикл
					ПроверитьГруппу(Группа, Группы, Ошибки);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Если Группы.Количество() = 0 Тогда
		Ошибки.Добавить(НСтр("ru = 'В снимке нет ни одной группы: выгрузка очистила бы расписание на сайте.'"));
	КонецЕсли;

	Для Каждого РасписаниеГруппы Из Снимок.schedules Цикл
		ИдГруппы = РасписаниеГруппы.Ключ;
		Если Группы.Получить(ИдГруппы) = Неопределено Тогда
			Если ГП_СайтРасписания.ИдентификаторДопустим(ИдГруппы) Тогда
				Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Есть занятия для группы «%1», которой нет в дереве.'"), ИдГруппы));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Для Каждого Неделя Из РасписаниеГруппы.Значение Цикл
			ПроверитьНеделю(Группы.Получить(ИдГруппы), Неделя.Ключ, Неделя.Значение, Ошибки);
		КонецЦикла;
	КонецЦикла;

	МаксимумОшибок = 50;
	Если Ошибки.Количество() > МаксимумОшибок Тогда
		Всего = Ошибки.Количество();
		Пока Ошибки.Количество() > МаксимумОшибок Цикл
			Ошибки.Удалить(Ошибки.ВГраница());
		КонецЦикла;
		Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '...и ещё ошибок: %1'"), Всего - МаксимумОшибок));
	КонецЕсли;

	Возврат Ошибки;

КонецФункции

#КонецОбласти

#Область Токен

// Возвращаемое значение:
//  СправочникСсылка.ИдентификаторыОбъектовМетаданных
//
Функция ВладелецТокена() Экспорт

	Возврат ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Константа.ГП_АдресСайтаРасписания");

КонецФункции

// Возвращаемое значение:
