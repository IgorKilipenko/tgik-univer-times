Функция ТокенИмпорта() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Возврат ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецТокена(), "ТокенИмпорта");

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИдентификаторыДляСайта

Процедура ЗаблокироватьРегистрИдентификаторов()

	// Уникальность ид проверяется запросом, поэтому на время проверки и записи блокируется весь
	// регистр; записей мало, назначение ид — редкая операция.
	Блокировка = Новый БлокировкаДанных;
	Блокировка.Добавить("РегистрСведений.ГП_ИдентификаторыДляСайтаРасписания");
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура ЗаписатьВРегистр(Объект, Идентификатор)

	Запись = РегистрыСведений.ГП_ИдентификаторыДляСайтаРасписания.СоздатьМенеджерЗаписи();
	Запись.Объект = Объект;
	Запись.Идентификатор = Идентификатор;
	Запись.Записать(Истина);

КонецПроцедуры

Функция СвободныйИдентификатор(Основа, Объект)

	Кандидат = Основа;
	Номер = 1;
	Пока ЗначениеЗаполнено(ОбъектСИдентификатором(Кандидат, Объект)) Цикл
		Номер = Номер + 1;
		Суффикс = "-" + Формат(Номер, "ЧГ=0");
		Кандидат = Лев(Основа, ГП_СайтРасписания.МаксимальнаяДлинаИдентификатора() - СтрДлина(Суффикс)) + Суффикс;
	КонецЦикла;

	Возврат Кандидат;

КонецФункции

// Возвращаемое значение:
//  ОпределяемыйТип.ГП_ОбъектСайтаРасписания, Неопределено - другой объект с этим ид.
//
Функция ОбъектСИдентификатором(Идентификатор, КромеОбъекта)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Запрос.УстановитьПараметр("КромеОбъекта", КромеОбъекта);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ид.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.ГП_ИдентификаторыДляСайтаРасписания КАК Ид
	|ГДЕ
	|	Ид.Идентификатор = &Идентификатор
	|	И Ид.Объект <> &КромеОбъекта";

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Объект, Неопределено);

КонецФункции

#КонецОбласти

#Область ПроверкаСнимка

Процедура ПроверитьУзелДерева(Узел, Вид, Ошибки)

	Если Не ЗначениеЗаполнено(Узел.id) Или Не ЗначениеЗаполнено(Узел.label) Тогда
		Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1 «%2»: не заполнены ид или наименование.'"), Вид, Узел.label));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьГруппу(Группа, Группы, Ошибки)

	Если Не ГП_СайтРасписания.ИдентификаторДопустим(Группа.id) Тогда
		Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Группа «%1»: не задан или недопустим ид для сайта («%2»). Заполните регистр «Идентификаторы для сайта».'"),
			Группа.label, Группа.id));
	ИначеЕсли Группы.Получить(Группа.id) <> Неопределено Тогда
		Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Группы «%1» и «%2»: одинаковый ид для сайта «%3».'"),
			Группы.Получить(Группа.id), Группа.label, Группа.id));
	Иначе
		Группы.Вставить(Группа.id, Группа.label);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьНеделю(НаименованиеГруппы, КлючНедели, Занятия, Ошибки)

	Если Не КлючНеделиДопустим(КлючНедели) Тогда
		Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Группа «%1»: недопустимый ключ недели «%2», ожидается вида 2026-W40.'"),
			НаименованиеГруппы, КлючНедели));
		Возврат;
	КонецЕсли;

	Для Каждого Занятие Из Занятия Цикл

		Проблема = "";
		Если ТипЗнч(Занятие.day) <> Тип("Число") Или Занятие.day < 1 Или Занятие.day > 7 Тогда
			Проблема = НСтр("ru = 'день недели не от 1 до 7'");
		ИначеЕсли Не ВремяДопустимо(Занятие.start) Или Не ВремяДопустимо(Занятие.end) Тогда
			Проблема = НСтр("ru = 'время не в формате ЧЧ:ММ'");
		ИначеЕсли Занятие.start >= Занятие.end Тогда
			Проблема = НСтр("ru = 'начало не раньше окончания'");
		ИначеЕсли Не ЗначениеЗаполнено(Занятие.subject) Тогда
			Проблема = НСтр("ru = 'не заполнена дисциплина'");
		КонецЕсли;

		Если ЗначениеЗаполнено(Проблема) Тогда
			Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Группа «%1», неделя %2, день %3, %4: %5.'"),
				НаименованиеГруппы, КлючНедели, Занятие.day, Занятие.start, Проблема));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция КлючНеделиДопустим(КлючНедели)

	Если СтрДлина(КлючНедели) <> 8 Или Сред(КлючНедели, 5, 2) <> "-W"
		Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Лев(КлючНедели, 4))
		Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Прав(КлючНедели, 2)) Тогда
		Возврат Ложь;
	КонецЕсли;

	НомерНедели = Число(Прав(КлючНедели, 2));
	Возврат НомерНедели >= 1 И НомерНедели <= 53;

КонецФункции

Функция ВремяДопустимо(Время)

	Если ТипЗнч(Время) <> Тип("Строка") Или СтрДлина(Время) <> 5 Или Сред(Время, 3, 1) <> ":"
		Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Лев(Время, 2))
		Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Прав(Время, 2)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Число(Лев(Время, 2)) < 24 И Число(Прав(Время, 2)) < 60;

КонецФункции

#КонецОбласти

Функция НовоеСоединение(URI)

	ЗащищенноеСоединение = Неопределено;
	Если НРег(URI.Схема) = "https" Тогда
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
	КонецЕсли;

	Прокси = Неопределено;
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПолучениеФайловИзИнтернета") Тогда
		МодульПолучениеФайловИзИнтернета = ОбщегоНазначения.ОбщийМодуль("ПолучениеФайловИзИнтернета");
		Прокси = МодульПолучениеФайловИзИнтернета.ПолучитьПрокси(URI.Схема);
	КонецЕсли;

	Возврат Новый HTTPСоединение(URI.Хост, URI.Порт, , , Прокси, 60, ЗащищенноеСоединение);

КонецФункции

Функция СтрокаПараметров(ПараметрыЗапроса)

	Если ПараметрыЗапроса = Неопределено Или ПараметрыЗапроса.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Части.Добавить(Параметр.Ключ + "=" + КодироватьСтроку(Параметр.Значение, СпособКодированияСтроки.КодировкаURL));
	КонецЦикла;

	Возврат "?" + СтрСоединить(Части, "&");

КонецФункции

// ОбщегоНазначения.ЗначениеВJSON() пишет с переносами и отступами, а размер тела
// ограничен client_max_body_size nginx (по умолчанию 1 МБ).
Функция КомпактныйJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Процедура РазобратьОтвет(Ответ, Результат)

	Результат.КодСостояния = Ответ.КодСостояния;
	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

	Попытка
		Данные = ОбщегоНазначения.JSONВЗначение(ТекстОтвета, , Истина);
	Исключение
		Данные = Неопределено;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		// Ответ не от API: страница nginx (413, 502), HTML при неверном адресе сайта и т.п.
		Результат.КодОшибки = "invalid_response";
		Результат.ТекстОшибки = Лев(ТекстОтвета, 300);
		Возврат;
	КонецЕсли;

	Если Данные.Получить("ok") = Истина Тогда
		Результат.Успех = Истина;
		Результат.Данные = Данные.Получить("data");
		Возврат;
	КонецЕсли;

	Ошибка = Данные.Получить("error");
	Если ТипЗнч(Ошибка) = Тип("Соответствие") Тогда
		Результат.КодОшибки = Строка(Ошибка.Получить("code"));
		Результат.ТекстОшибки = Строка(Ошибка.Получить("message"));
	Иначе
		Результат.КодОшибки = "unknown_error";
		Результат.ТекстОшибки = Лев(ТекстОтвета, 300);
	КонецЕсли;

КонецПроцедуры

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'Сайт расписания.Выгрузка'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

