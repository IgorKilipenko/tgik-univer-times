КонецФункции

// Сохраняет Bearer-токен импорта в безопасное хранилище.
// На сайте тот же токен задаётся в settings/config.local.php.
//
// Параметры:
//  Токен - Строка
//
Процедура УстановитьТокенИмпорта(Знач Токен) Экспорт
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для изменения токена сайта расписания.'");
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
		ГП_СайтРасписанияСлужебный.ВладелецТокена(), СокрЛП(Токен), "ТокенИмпорта");
КонецПроцедуры

// Возвращаемое значение:
//  Булево
//
Функция ТокенИмпортаЗадан() Экспорт
	Возврат ЗначениеЗаполнено(ГП_СайтРасписанияСлужебный.ТокенИмпорта());
КонецФункции

#КонецОбласти // Настройки

#Область Снимок

// Снимок — Структура, которую ЗаписатьJSON() сериализует в формат import.php без доработок:
//
//	{
//	  "meta":      { "generatedAt": "2026-09-28T06:00:00+05:00", "source": "1c" },
//	  "tree":      [ отделение → факультеты → курсы → группы ],
//	  "schedules": { "<ид группы>": { "2026-W40": [ занятия ] } }
//	}
//
// Ид групп ("fmtkh-2-01") и ключи недель ("2026-W40") не являются допустимыми ключами
// Структуры, поэтому "schedules" собирается из Соответствий.

// Возвращаемое значение:
//  Структура:
//   * meta - Структура
//   * tree - Массив из см. ДобавитьОтделение
//   * schedules - Соответствие из КлючИЗначение:
//     ** Ключ - Строка - ид группы.
//     ** Значение - Соответствие из КлючИЗначение - ключ недели → Массив занятий.
//
Функция НовыйСнимок() Экспорт
	Мета = Новый Структура;
	Мета.Вставить("generatedAt", ДатаВремяISO(ТекущаяДатаСеанса()));
	Мета.Вставить("source", "1c");

	Снимок = Новый Структура;
	Снимок.Вставить("meta", Мета);
	Снимок.Вставить("tree", Новый Массив);
	Снимок.Вставить("schedules", Новый Соответствие);

	Возврат Снимок;
КонецФункции

// Параметры:
//  Снимок - см. НовыйСнимок
//  Ид - Строка - стабильный идентификатор (латиница, цифры, дефис), например "full-time".
//  Наименование - Строка
//
// Возвращаемое значение:
//  Структура - узел дерева для ДобавитьФакультет().
//
Функция ДобавитьОтделение(Снимок, Знач Ид, Знач Наименование) Экспорт
	Отделение = Новый Структура("id, label, faculties", Ид, Наименование, Новый Массив);
	Снимок.tree.Добавить(Отделение);
    
	Возврат Отделение;
КонецФункции

// Параметры:
//  Отделение - см. ДобавитьОтделение
//  Ид - Строка - например "fmtkh".
//  Наименование - Строка
//
// Возвращаемое значение:
//  Структура - узел дерева для ДобавитьКурс().
//
Функция ДобавитьФакультет(Отделение, Знач Ид, Знач Наименование) Экспорт
	Факультет = Новый Структура("id, label, courses", Ид, Наименование, Новый Массив);
	Отделение.faculties.Добавить(Факультет);
    
	Возврат Факультет;
КонецФункции

// Параметры:
//  Факультет - см. ДобавитьФакультет
//  НомерКурса - Число
//
// Возвращаемое значение:
//  Структура - узел дерева для ДобавитьГруппу().
//
Функция ДобавитьКурс(Факультет, Знач НомерКурса) Экспорт
	Курс = Новый Структура("course, groups", НомерКурса, Новый Массив);
	Факультет.courses.Добавить(Курс);
    
	Возврат Курс;
КонецФункции

// Добавляет группу в дерево и заводит для неё пустое расписание.
//
// Параметры:
//  Снимок - см. НовыйСнимок
//  Курс - см. ДобавитьКурс
//  Ид - Строка - попадает в ссылки /?group=..., которые сохраняют студенты; менять нельзя.
//  Наименование - Строка - например "МТХ-201".
//
Процедура ДобавитьГруппу(Снимок, Курс, Знач Ид, Знач Наименование) Экспорт
	Курс.groups.Добавить(Новый Структура("id, label", Ид, Наименование));

	Если Снимок.schedules.Получить(Ид) = Неопределено Тогда
		Снимок.schedules.Вставить(Ид, Новый Соответствие);
	КонецЕсли;
КонецПроцедуры

// Добавляет занятие; неделя и день недели вычисляются из даты.
// Сайт не сортирует занятия — добавляйте их в порядке даты и времени начала.
//
// Параметры:
//  Снимок - см. НовыйСнимок
//  ИдГруппы - Строка - группа должна быть добавлена через ДобавитьГруппу().
//  Дата - Дата
//  Начало - Строка, Дата - "09:00" или дата со временем начала.
//  Окончание - Строка, Дата - "10:30" или дата со временем окончания.
//  Дисциплина - Строка
//  ВидЗанятия - Строка - лекция, практика, семинар, лабораторная, консультация, зачёт, экзамен.
//  Аудитория - Строка
//  Преподаватель - Строка - например "Иванов И.И.".
//
Процедура ДобавитьЗанятие(Снимок, Знач ИдГруппы, Знач Дата, Знач Начало, Знач Окончание,
	Знач Дисциплина, Знач ВидЗанятия, Знач Аудитория, Знач Преподаватель) Экспорт

	РасписаниеГруппы = Снимок.schedules.Получить(ИдГруппы);
	Если РасписаниеГруппы = Неопределено Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Группа %1 не добавлена в дерево снимка'"), ИдГруппы);
	КонецЕсли;

	Неделя = КлючНедели(Дата);
	ЗанятияНедели = РасписаниеГруппы.Получить(Неделя);
	Если ЗанятияНедели = Неопределено Тогда
		ЗанятияНедели = Новый Массив;
		РасписаниеГруппы.Вставить(Неделя, ЗанятияНедели);
	КонецЕсли;

	Занятие = Новый Структура;
	Занятие.Вставить("day", ДеньНедели(Дата));
	Занятие.Вставить("start", ВремяЧЧММ(Начало));
	Занятие.Вставить("end", ВремяЧЧММ(Окончание));
	Занятие.Вставить("subject", СокрЛП(Дисциплина));
	Занятие.Вставить("type", НРег(СокрЛП(ВидЗанятия)));
	Занятие.Вставить("room", СокрЛП(Аудитория));
	Занятие.Вставить("teacher", СокрЛП(Преподаватель));

	ЗанятияНедели.Добавить(Занятие);
КонецПроцедуры

// ISO-неделя в формате сайта: "2026-W40".
// Встроенная НеделяГода() считает недели не по ISO 8601, поэтому не подходит.
//
// Параметры:
//  Дата - Дата
//
// Возвращаемое значение:
//  Строка
//
Функция КлючНедели(Знач Дата) Экспорт
	// Год и номер ISO-недели определяются по четвергу этой недели.
	Четверг = НачалоНедели(Дата) + 3 * 86400;
	НомерНедели = Цел((ДеньГода(Четверг) - 1) / 7) + 1;

	Возврат Формат(Год(Четверг), "ЧГ=0") + "-W" + Формат(НомерНедели, "ЧЦ=2; ЧВН=");
КонецФункции

// Дата и время в ISO 8601 со смещением Тюмени (UTC+5, без перехода на летнее время).
// Ожидается, что дата сеанса — в часовом поясе института.
//
// Параметры:
//  Дата - Дата
//
// Возвращаемое значение:
//  Строка - например "2026-09-28T06:00:00+05:00".
//
Функция ДатаВремяISO(Знач Дата) Экспорт
	Возврат Формат(Дата, "ДФ=yyyy-MM-dd") + "T" + Формат(Дата, "ДФ=HH:mm:ss; ДП=00:00:00") + "+05:00";
КонецФункции

#КонецОбласти // Снимок

// Результат всех функций обмена с сайтом.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * КодСостояния - Число - HTTP-код; 0 — запрос не дошёл до сайта.
//   * Данные - Соответствие, Неопределено - поле data ответа API.
//   * КодОшибки - Строка - error.code ответа API или код клиента: network_error, invalid_response, not_configured.
//   * ТекстОшибки - Строка
//
Функция НовыйРезультатОбмена() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("Данные", Неопределено);
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("ТекстОшибки", "");
    
	Возврат Результат;
КонецФункции

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

Функция ВремяЧЧММ(Знач Время)
	Если ТипЗнч(Время) = Тип("Дата") Тогда
		Возврат Формат(Время, "ДФ=HH:mm; ДП=00:00");
	КонецЕсли;

	Возврат СокрЛП(Время);
КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
