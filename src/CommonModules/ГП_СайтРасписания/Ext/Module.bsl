#Область ИдентификаторыДляСайта

// Ид объектов хранятся в регистре сведений ГП_ИдентификаторыДляСайтаРасписания и попадают в ссылки
// вида /?group=mtkh-201, которые сохраняют студенты. Назначаются один раз (подписка на событие
// ГП_НазначитьИдентификаторДляСайта) и при переименовании объекта не меняются.

// Ид из регистра.
//
// Параметры:
//  Объекты - Массив из ОпределяемыйТип.ГП_ОбъектСайтаРасписания
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - ОпределяемыйТип.ГП_ОбъектСайтаРасписания
//   * Значение - Строка
//  Объектов без ид в соответствии нет.
//
Функция ИдентификаторыДляСайта(Объекты) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объекты", Объекты);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ид.Объект КАК Объект,
	|	Ид.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ГП_ИдентификаторыДляСайтаРасписания КАК Ид
	|ГДЕ
	|	Ид.Объект В (&Объекты)";

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Объект, Выборка.Идентификатор);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Назначает ид объектам, у которых его ещё нет: транслитерация наименования,
// при совпадении с занятым — суффикс "-2", "-3"...
// Для первичного заполнения: передать все публикуемые группы.
//
// Параметры:
//  Объекты - Массив из ОпределяемыйТип.ГП_ОбъектСайтаРасписания
//
// Возвращаемое значение:
//  Число - сколько ид назначено.
//
Функция ЗаполнитьНедостающиеИдентификаторы(Объекты) Экспорт

	Назначено = 0;
	Существующие = ИдентификаторыДляСайта(Объекты);
	Наименования = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Объекты, "Наименование");

	Для Каждого Объект Из Объекты Цикл
		Если Существующие.Получить(Объект) = Неопределено Тогда
			ГП_СайтРасписанияСлужебный.НазначитьИдентификатор(Объект, Наименования.Получить(Объект));
			Назначено = Назначено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Назначено;

КонецФункции

// Задаёт ид вручную. Старые ссылки на сайт с прежним ид перестанут работать.
//
// Параметры:
//  Объект - ОпределяемыйТип.ГП_ОбъектСайтаРасписания
//  Идентификатор - Строка - допустимый (см. ИдентификаторДопустим) и не занятый другим объектом.
//
Процедура УстановитьИдентификаторДляСайта(Объект, Знач Идентификатор) Экспорт

	ГП_СайтРасписанияСлужебный.ЗаписатьИдентификатор(Объект, НРег(СокрЛП(Идентификатор)));

КонецПроцедуры

// Ид из наименования: "МТХ-201" → "mtkh-201", "СКТз 401" → "sktz-401".
//
// Параметры:
//  Наименование - Строка
//
// Возвращаемое значение:
//  Строка - может быть пустой, если в наименовании нет букв и цифр.
//
Функция ИдентификаторИзНаименования(Наименование) Экспорт

	Латиница = НРег(СтроковыеФункцииКлиентСервер.СтрокаЛатиницей(СокрЛП(Наименование)));

	Части = Новый Массив;
	Для Позиция = 1 По СтрДлина(Латиница) Цикл
		Символ = Сред(Латиница, Позиция, 1);
		Если СтрНайти(ДопустимыеСимволыИдентификатора(), Символ) = 0 Тогда
			Символ = "-";
		КонецЕсли;
		Если Символ = "-" И (Части.Количество() = 0 Или Части[Части.ВГраница()] = "-") Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(Символ);
	КонецЦикла;

	Идентификатор = Лев(СтрСоединить(Части), МаксимальнаяДлинаИдентификатора());
	Пока СтрЗаканчиваетсяНа(Идентификатор, "-") Цикл
		Идентификатор = Лев(Идентификатор, СтрДлина(Идентификатор) - 1);
	КонецЦикла;

	Возврат Идентификатор;

КонецФункции

// Ид допустим, если он непустой, не длиннее МаксимальнаяДлинаИдентификатора(),
// состоит из a-z, 0-9 и дефиса и не начинается и не заканчивается дефисом.
//
// Параметры:
//  Идентификатор - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ИдентификаторДопустим(Идентификатор) Экспорт

	Длина = СтрДлина(Идентификатор);
	Если Длина = 0 Или Длина > МаксимальнаяДлинаИдентификатора()
		Или Лев(Идентификатор, 1) = "-" Или Прав(Идентификатор, 1) = "-" Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По Длина Цикл
		Если СтрНайти(ДопустимыеСимволыИдентификатора(), Сред(Идентификатор, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Длина ресурса Идентификатор регистра ГП_ИдентификаторыДляСайтаРасписания.
//
// Возвращаемое значение:
//  Число
//
Функция МаксимальнаяДлинаИдентификатора() Экспорт

	Возврат 50;

КонецФункции

