// Обработка ГП_НастройкиСайтаРасписания, форма Форма (основная).
//
// Реквизиты формы:
//  АдресСайта - Строка(500) - "https://time.tumgik.ru", "http://93.183.83.197:8080".
//  ИспользоватьВыгрузку - Булево - функциональная опция, включает регламентное задание.
//  Токен - Строка(200) - поле с РежимПароля; пусто — токен не меняется.
//  ТокенЗадан - Булево - только для отображения.
// Команды: Записать, ПроверитьСвязь, ВыгрузитьСейчас.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭтотОбъект.АдресСайта = ГП_СайтРасписания.АдресСайта();
	ЭтотОбъект.ИспользоватьВыгрузку = Константы.ГП_ИспользоватьВыгрузкуРасписанияНаСайт.Получить();
	ЭтотОбъект.ТокенЗадан = ГП_СайтРасписания.ТокенИмпортаЗадан();

	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		//ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)

	Запросы = ЗапросыРазрешенийНаСервере(ЭтотОбъект.АдресСайта);
	Оповещение = Новый ОписаниеОповещения("ЗаписатьПослеПримененияРазрешений", ЭтотОбъект);
	РаботаВБезопасномРежимеКлиент.ПрименитьЗапросыНаИспользованиеВнешнихРесурсов(Запросы, ЭтотОбъект, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСвязь(Команда)

	Если Не ПроверитьЧтоНастройкиЗаписаны() Тогда
		Возврат;
	КонецЕсли;

	Если СайтДоступенНаСервере() Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Сайт расписания доступен'"), , ЭтотОбъект.АдресСайта);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Сайт расписания недоступен. Проверьте адрес и доступ к сети с сервера 1С.'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьСейчас(Команда)

	Если Не ПроверитьЧтоНастройкиЗаписаны() Тогда
		Возврат;
	КонецЕсли;

	ДлительнаяОперация = НачатьВыгрузкуНаСервере();

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Выгрузка расписания на сайт...'");
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация,
		Новый ОписаниеОповещения("ПослеВыгрузки", ЭтотОбъект), ПараметрыОжидания);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаписатьПослеПримененияРазрешений(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьНаСервере();
	Модифицированность = Ложь;
	ПоказатьОповещениеПользователя(НСтр("ru = 'Настройки сайта расписания сохранены'"));

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыгрузки(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат; // Пользователь отменил ожидание.
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;

	Выгрузка = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	Если Выгрузка.Успех Тогда
		Статистика = Выгрузка.Данные.Получить("stats");
		ПоказатьОповещениеПользователя(НСтр("ru = 'Расписание выгружено на сайт'"), ,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Групп: %1'"),
				Статистика.Получить("groups")));
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось выгрузить расписание: HTTP %1, %2: %3'"),
			Выгрузка.КодСостояния, Выгрузка.КодОшибки, Выгрузка.ТекстОшибки));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПроверитьЧтоНастройкиЗаписаны()

	Если Модифицированность Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Сначала запишите настройки.'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Функция ЗапросыРазрешенийНаСервере(Знач НовыйАдресСайта)

	Возврат ГП_СайтРасписанияСлужебный.ЗапросыРазрешенийНаИспользованиеВнешнихРесурсов(СокрЛП(НовыйАдресСайта));

КонецФункции

&НаСервере
Процедура ЗаписатьНаСервере()

	Константы.ГП_АдресСайтаРасписания.Установить(СокрЛП(ЭтотОбъект.АдресСайта));
	Константы.ГП_ИспользоватьВыгрузкуРасписанияНаСайт.Установить(ЭтотОбъект.ИспользоватьВыгрузку);

	Если ЗначениеЗаполнено(ЭтотОбъект.Токен) Тогда
		ГП_СайтРасписания.УстановитьТокенИмпорта(ЭтотОбъект.Токен);
		ЭтотОбъект.Токен = "";
	КонецЕсли;
	ТокенЗадан = ГП_СайтРасписания.ТокенИмпортаЗадан();

КонецПроцедуры

&НаСервереБезКонтекста
Функция СайтДоступенНаСервере()

	Возврат ГП_СайтРасписания.СайтДоступен();

КонецФункции

&НаСервере
Функция НачатьВыгрузкуНаСервере()

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Выгрузка расписания на сайт'");

	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "ГП_СайтРасписания.ВыгрузитьРасписание");

КонецФункции

#КонецОбласти
